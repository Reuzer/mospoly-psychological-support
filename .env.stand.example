# Шаблон .env для стенда. На сервере копируется рядом с docker-compose.stand.yml
# и заполняется реальными значениями. В git не коммитится.

# Стенд: prod или dev. Определяет имена контейнеров, томов и docker-сети.
STAND=prod

# --- Приложение ---
APP_HOST=0.0.0.0
APP_PORT=8000
IMAGE_DIR=/srv/images
RESET_DB_ON_START=false
LOG_LEVEL=INFO

# --- База данных ---
# POSTGRES_HOST и POSTGRES_PORT задаются в compose, здесь их указывать не нужно.
POSTGRES_USER=psychohelp
POSTGRES_PASSWORD=
POSTGRES_DB=psychohelp

# --- JWT ---
# ВАЖНО: на prod и dev должны быть РАЗНЫЕ ключи. При одинаковом ключе токен,
# выданный дев-стендом, окажется валидным в проде, а id пользователя в нём
# указывает на другого человека из дев-базы.
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE=43200

# --- Почта ---
MAIL_SERVICE_URL=
MAIL_SERVICE_FROM_USER=
MAIL_FROM_NAME=Психологическая поддержка Мосполитеха
MAIL_REQUEST_TIMEOUT_SECONDS=10

# --- Сброс пароля ---
# Публичный адрес стенда, каким его видит пользователь в письме.
# prod: https://95.31.169.106   dev: https://95.31.169.106:8443
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_URL_TEMPLATE=https://95.31.169.106/reset-password?token={token}
